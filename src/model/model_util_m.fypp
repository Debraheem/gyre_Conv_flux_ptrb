#:include 'gyre.inc'

module model_util_m

   ! Uses

   use forum_m, only: RD

   use constants_m
   use model_m
   use model_par_m
   use util_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Access specifiers

   public :: snap_points
   public :: check_model
   public :: model_coeff_i
   public :: model_dcoeff_i
   public :: model_coeff_name
   public :: model_dcoeff_name

   ! Default access

   private

contains

   subroutine snap_points(dx_snap, x, m)

      real(RD), intent(in)              :: dx_snap
      real(RD), intent(inout)           :: x(:)
      real(RD), optional, intent(inout) :: m(:)

      integer  :: i
      real(RD) :: x_snap
      real(RD) :: m_snap

      if (PRESENT(m)) then
         @:CHECK_BOUNDS(SIZE(m), SIZE(x))
      endif

      ! Snap model points to fix possible numerical issues

      ! Central point

      if (x(1) > 0._RD .AND. x(1) < dx_snap) then

         x(1) = 0._RD

         if (PRESENT(m)) then
            m(1) = 0._RD
         endif

         if (check_log_level('INFO')) then
            write(OUTPUT_UNIT, 100) 'Snapping central point to x=0'
100         format(3X,A)
         endif

      endif

      ! Other points

      snap_loop : do i = 2, SIZE(x)-1

         if (x(i+1) - x(i) > 0._RD .AND. x(i+1) - x(i) < dx_snap) then

            x_snap = 0.5_RD*(x(i+1) + x(i))
            x(i:i+1) = x_snap

            if (PRESENT(m)) then
               m_snap = 0.5_RD*(m(i+1) + m(i))
               m(i:i+1) = m_snap
            endif

            if (check_log_level('INFO')) then
               write(OUTPUT_UNIT, 110) 'Snapping points', i, 'and', i+1, 'to x=', x_snap
110            format(3X,A,1X,I0,1X,A,1X,I0,1X,A,F6.4)
            endif

         end if

      end do snap_loop

      ! Finish

      return

   end subroutine snap_points

   !****

   subroutine check_model(ml, i_req)

      class(model_t), intent(in) :: ml
      integer, intent(in)        :: i_req(:)

      logical :: missing_coeffs
      integer :: j

      ! Check that the model has the required coefficients, listed in
      ! i_req

      missing_coeffs = .FALSE.

      do j = 1, SIZE(i_req)

         if (.NOT. ml%is_defined(i_req(j))) then

            if (.NOT. missing_coeffs) then
               write(OUTPUT_UNIT, 100) 'Model lacks the following structure coefficients:'
100            format(A)
               missing_coeffs = .TRUE.
            end if

            write(OUTPUT_UNIT, 110) model_coeff_name(i_req(j))
110         format(3X, A)

         end if

      end do

      if (missing_coeffs) then
         @:ABORT('model check failed')
      endif

      ! Finish

      return

   end subroutine check_model

   !****

   function model_coeff_i(name) result(i)

      character(*), intent(in) :: name
      integer                  :: i

      ! Determine the coefficient index from its name

      select case (name)
      case ('V_2')
         i = I_V_2
      case ('A*')
         i = I_AS
      case ('U')
         i = I_U
      case ('c_1')
         i = I_C_1
      case ('Gamma_1')
         i = I_GAMMA_1
      case ('nabla')
         i = I_NABLA
      case ('nabla_ad')
         i = I_NABLA_AD
      case ('beta_rad')
         i = I_BETA_RAD
      case ('c_rad')
         i = I_C_RAD
      case ('c_thn')
         i = I_C_THN
      case ('c_thk')
         i = I_C_THK
      case ('c_eps')
         i = I_C_EPS
      case ('c_egv')
         i = I_C_EGV
      case ('eps_rho')
         i = I_EPS_RHO
      case ('eps_T')
         i = I_EPS_T
      case ('kap_rho')
         i = I_KAP_RHO
      case ('kap_T')
         i = I_KAP_T
      case ('Omega_rot')
         i = I_OMEGA_ROT
      case ('tdc_r')
         i = I_TDC_R
      case ('tdc_m')
         i = I_TDC_M
      case ('tdc_L_r')
         i = I_TDC_L_R
      case ('tdc_Peos')
         i = I_TDC_PEOS
      case ('tdc_T')
         i = I_TDC_T
      case ('tdc_rho')
         i = I_TDC_RHO
      case ('tdc_kap')
         i = I_TDC_KAP
      case ('tdc_L_conv0')
         i = I_TDC_L_CONV0
      case ('tdc_A0')
         i = I_TDC_A0
      case ('tdc_D_h')
         i = I_TDC_D_H
      case ('tdc_c_hfc')
         i = I_TDC_C_HFC
      case ('tdc_Hp')
         i = I_TDC_HP
      case ('tdc_alpha_mlt')
         i = I_TDC_ALPHA_MLT
      case ('tdc_Cp')
         i = I_TDC_CP
      case ('tdc_chiT')
         i = I_TDC_CHIT
      case ('tdc_chiRho')
         i = I_TDC_CHIRHO
      case ('tdc_gradL')
         i = I_TDC_GRADL
      case ('tdc_gradT')
         i = I_TDC_GRADT
      case ('tdc_alpha_C')
         i = I_TDC_ALPHA_C
      case ('tdc_alpha_S')
         i = I_TDC_ALPHA_S
      case ('tdc_alpha_D')
         i = I_TDC_ALPHA_D
      case ('tdc_alpha_R')
         i = I_TDC_ALPHA_R
      case ('tdc_alpha_Pt')
         i = I_TDC_ALPHA_PT
      case ('tdc_alpha_M')
         i = I_TDC_ALPHA_M
      case ('tdc_include_mlt_corr')
         i = I_TDC_INCLUDE_MLT_CORR
      case ('tdc_mlt_Pturb_factor')
         i = I_TDC_MLT_PTURB_FACTOR
      case ('tdc_mlt_Pturb0')
         i = I_TDC_MLT_PTURB0
      case default
         @:ABORT('invalid coefficient name')
      end select

      ! Finish

      return

   end function model_coeff_i

   !****

   function model_dcoeff_i(name) result(i)

      character(*), intent(in) :: name
      integer                  :: i

      character(:), allocatable :: name_

      ! Determine the coefficient derivative index from its name

      if (name(1:1) == 'd') then
         name_ = name(2:)
         i = model_coeff_i(name_)
      else
         i = 0
      endif

      ! Finish

      return

   end function model_dcoeff_i

   !****

   function model_coeff_name(i) result(name)

      integer, intent(in)       :: i
      character(:), allocatable :: name

      ! Determine the coefficient name from its index

      select case (i)
      case (I_V_2)
         name = 'V_2'
      case (I_AS)
         name = 'A*'
      case (I_U)
         name = 'U'
      case (I_C_1)
         name = 'c_1'
      case (I_GAMMA_1)
         name = 'Gamma_1'
      case (I_NABLA)
         name = 'nabla'
      case (I_NABLA_AD)
         name = 'nabla_ad'
      case (I_BETA_RAD)
         name = 'beta_rad'
      case (I_C_RAD)
         name = 'c_rad'
      case (I_C_THN)
         name = 'c_thn'
      case (I_C_THK)
         name = 'c_thk'
      case (I_C_EPS)
         name = 'c_eps'
      case (I_C_EGV)
         name = 'c_egv'
      case (I_EPS_RHO)
         name = 'eps_rho'
      case (I_EPS_T)
         name = 'eps_T'
      case (I_KAP_RHO)
         name = 'kap_rho'
      case (I_KAP_T)
         name = 'kap_T'
      case (I_OMEGA_ROT)
         name = 'Omega_rot'
      case (I_TDC_R)
         name = 'tdc_r'
      case (I_TDC_M)
         name = 'tdc_m'
      case (I_TDC_L_R)
         name = 'tdc_L_r'
      case (I_TDC_PEOS)
         name = 'tdc_Peos'
      case (I_TDC_T)
         name = 'tdc_T'
      case (I_TDC_RHO)
         name = 'tdc_rho'
      case (I_TDC_KAP)
         name = 'tdc_kap'
      case (I_TDC_L_CONV0)
         name = 'tdc_L_conv0'
      case (I_TDC_A0)
         name = 'tdc_A0'
      case (I_TDC_D_H)
         name = 'tdc_D_h'
      case (I_TDC_C_HFC)
         name = 'tdc_c_hfc'
      case (I_TDC_HP)
         name = 'tdc_Hp'
      case (I_TDC_ALPHA_MLT)
         name = 'tdc_alpha_mlt'
      case (I_TDC_CP)
         name = 'tdc_Cp'
      case (I_TDC_CHIT)
         name = 'tdc_chiT'
      case (I_TDC_CHIRHO)
         name = 'tdc_chiRho'
      case (I_TDC_GRADL)
         name = 'tdc_gradL'
      case (I_TDC_GRADT)
         name = 'tdc_gradT'
      case (I_TDC_ALPHA_C)
         name = 'tdc_alpha_C'
      case (I_TDC_ALPHA_S)
         name = 'tdc_alpha_S'
      case (I_TDC_ALPHA_D)
         name = 'tdc_alpha_D'
      case (I_TDC_ALPHA_R)
         name = 'tdc_alpha_R'
      case (I_TDC_ALPHA_PT)
         name = 'tdc_alpha_Pt'
      case (I_TDC_ALPHA_M)
         name = 'tdc_alpha_M'
      case (I_TDC_INCLUDE_MLT_CORR)
         name = 'tdc_include_mlt_corr'
      case (I_TDC_MLT_PTURB_FACTOR)
         name = 'tdc_mlt_Pturb_factor'
      case (I_TDC_MLT_PTURB0)
         name = 'tdc_mlt_Pturb0'
      case default
         @:ABORT('invalid coefficient index')
      end select

      ! Finish

      return

   end function model_coeff_name

   !****

   function model_dcoeff_name(i) result(name)

      integer, intent(in)       :: i
      character(:), allocatable :: name

      ! Determine the coefficient derivative name from its index

      name = model_coeff_name(i)

      if (name /= '') name = 'd'//name

      ! Finish

      return

   end function model_dcoeff_name

end module model_util_m
